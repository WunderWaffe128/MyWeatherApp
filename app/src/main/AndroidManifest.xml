<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyWeatherApp"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true" />
        <activity
            android:name=".RadarActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity-alias
            android:name=".LauncherDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherSunny" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_sunny" android:roundIcon="@mipmap/ic_launcher_sunny"
            android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherCloudy" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_cloudy" android:roundIcon="@mipmap/ic_launcher_cloudy"
            android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherRain" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_rain" android:roundIcon="@mipmap/ic_launcher_rain"
            android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherSnow" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_snow" android:roundIcon="@mipmap/ic_launcher_snow"
            android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherNight" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_night" android:roundIcon="@mipmap/ic_launcher_night"
            android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherRainNight" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_rain_night" android:roundIcon="@mipmap/ic_launcher_rain_night"
            android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherSnowNight" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_snow_night" android:roundIcon="@mipmap/ic_launcher_snow_night"
            android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherCloudyNight" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_cloudy_night" android:roundIcon="@mipmap/ic_launcher_cloudy_night"
            android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherThunder" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_thunder" android:roundIcon="@mipmap/ic_launcher_thunder"
            android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherFog" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_fog" android:roundIcon="@mipmap/ic_launcher_fog"
            android:label="@string/app_name" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>

        <receiver
            android:name=".WeatherWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info" />
        </receiver>
    </application>

</manifest>
