<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_wide">

    <ViewFlipper
        android:id="@+id/widgetBackgroundMotion"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="3200"
        android:inAnimation="@anim/widget_float_in"
        android:outAnimation="@anim/widget_float_out">
        <ImageView android:id="@+id/widgetMotion1" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitCenter" />
        <ImageView android:id="@+id/widgetMotion2" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitCenter" />
        <ImageView android:id="@+id/widgetMotion3" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitCenter" />
    </ViewFlipper>

    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="end|bottom"
        android:alpha="0.48"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_glass_orbit" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widgetCity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="Откройте приложение"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
            <ImageView
                android:id="@+id/widgetRefresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_refresh_background"
                android:contentDescription="Обновить"
                android:padding="7dp"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            <ViewFlipper
                android:id="@+id/widgetIconMotion"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:autoStart="true"
                android:flipInterval="3000"
                android:inAnimation="@anim/widget_pulse_in"
                android:outAnimation="@anim/widget_pulse_out">
                <ImageView android:id="@+id/widgetIcon" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Погода" android:src="@drawable/ic_widget_cloud" />
                <ImageView android:id="@+id/widgetIcon2" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Погода" android:src="@drawable/ic_widget_cloud" />
                <ImageView android:id="@+id/widgetIcon3" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Погода" android:src="@drawable/ic_widget_cloud" />
            </ViewFlipper>
            <TextView
                android:id="@+id/widgetTemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="--°"
                android:textColor="#FFFFFFFF"
                android:textSize="42sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widgetCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:text="Нужна геолокация"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widgetHighLow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:text="Макс. --°  Мин. --°"
            android:textColor="#C7FFFFFF"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widgetUpdated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:text="Откройте приложение"
            android:textColor="#99FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
