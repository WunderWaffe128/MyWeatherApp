<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111F">

    <WebView
        android:id="@+id/radarWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="42dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:background="#B509192B">

        <ImageButton
            android:id="@+id/radarBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/glass_chip"
            android:contentDescription="Назад"
            android:padding="11dp"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFFFF" />

        <TextView
            android:id="@+id/radarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Радар осадков"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/radarStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/status_message"
        android:padding="16dp"
        android:text="Загружаем карту осадков…"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />
</FrameLayout>
